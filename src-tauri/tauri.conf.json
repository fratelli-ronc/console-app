{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "console-app",
  "version": "0.9.0",
  "identifier": "it.fratellironc.consoleapp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ronc Console",
        "maximized": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RUVBNjk3MTY2MzAxRkUKUldUK0FXTVdsNmJ1eUtqZ0FuUnZGcDRCZHN5ZHBBU24xN3h0aFlIeU9wUytuMjZ2OGhuR2JObVgK",
      "endpoints": [
        "https://github.com/fratelli-ronc/console-app/releases/latest/download/latest.json"
      ]
    }
  }
}